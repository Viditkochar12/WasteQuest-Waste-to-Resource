PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=

# AI Provider Configuration
# Explicit provider choice: 'gemini', 'anthropic', or 'mock'
WASTEQUEST_AI_PROVIDER=gemini

# Google Gemini Vision Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude Vision Configuration (Alternative)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Cloudinary image storage (required for POST /api/uploads)
# Create a Cloudinary account, then copy Cloud Name, API Key, and API Secret
# from the Cloudinary Console into server/.env. Keep API Secret server-side;
# never put these credentials in client/.env or VITE_* variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
